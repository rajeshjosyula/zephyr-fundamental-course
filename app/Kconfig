menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y
    help
      This option enables the LED subsystem.

if LED_SUBSYSTEM

choice 
    prompt "LED Blink Sleep Time"
    default BLINK_SLEEP_TIME_1000MS
    config BLINK_SLEEP_TIME_500MS
        bool "500ms (fast)"
    config BLINK_SLEEP_TIME_1000MS
        bool "1000ms (medium)"
    config BLINK_SLEEP_TIME_2000MS
        bool "2000ms (slow)"
endchoice

config BLINK_SLEEP_TIME_MS
    int 
    default 500 if BLINK_SLEEP_TIME_500MS
    default 1000 if BLINK_SLEEP_TIME_1000MS
    default 2000 if BLINK_SLEEP_TIME_2000MS
    default 0

menuconfig ADVANCED_LED_SUBSYSTEM
    bool "Advanced LED Subsystem"
    default n
    help
      This option enables the advanced LED subsystem.

if ADVANCED_LED_SUBSYSTEM

config LED_BRIGHTNESS
    int "LED Brightness"
    default 100
    range 0 100
    help
      This option sets the brightness level of the LED.

config LED_FADE_DURATION
    int "LED Fade duration (ms)"
    default 500
    range 0 1000
    help
      This option sets the fade duration of the LED.

menu "Expert Settings"
config LED_DEBUG
    bool "Enable LED Debugging"
    default n
    help
      This option enables debugging for the LED subsystem.

config LED_CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n
    help
      This option allows you to set a custom blink pattern for the LED.

endmenu

endif

endif

source "Kconfig.zephyr"